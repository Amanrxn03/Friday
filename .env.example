# Project FRIDAY - Environment Configuration Template
# DO NOT COMMIT SENSITIVE API KEYS TO SOURCE CONTROL
# Credentials can also be managed securely in the Windows Credential Manager via FRIDAY UI.

# Application Environment
FRIDAY_ENV=development
FRIDAY_DATA_DIR=data
FRIDAY_LOG_LEVEL=INFO

# AI Providers (Leave blank if using Ollama or configuring via Settings UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:latest

# Voice & Speech Settings
FRIDAY_VOICE_ENABLED=true
FRIDAY_VOICE_PROVIDER=local_sapi
FRIDAY_WAKE_WORD=Hey Friday
FRIDAY_SPEECH_RATE=180
FRIDAY_SPEECH_VOLUME=0.9

# Safe Autonomy & Permissions
# Modes: SUGGEST (1), APPROVED_AUTONOMY (2), CONFIRM_HIGH_IMPACT (3)
FRIDAY_AUTONOMY_MODE=APPROVED_AUTONOMY
FRIDAY_REQUIRE_CONFIRMATION_DELETES=true
FRIDAY_REQUIRE_CONFIRMATION_EXEC=true

# Morning Briefing & News
FRIDAY_NEWS_ENABLED=true
FRIDAY_BRIEFING_TIME=08:30
FRIDAY_QUIET_HOURS_START=22:00
FRIDAY_QUIET_HOURS_END=07:00
FRIDAY_WEATHER_LOCATION=
